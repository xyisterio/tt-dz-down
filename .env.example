# Токен бота от @BotFather
BOT_TOKEN=

# Твой числовой Telegram id (узнать можно у @userinfobot) — только этому
# id бот будет отвечать
OWNER_ID=

# Необязательно, но рекомендуется — иначе список каналов не переживёт
# рестарт контейнера. Берётся в консоли Upstash (Redis → REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Deezer (dzmedia-сервер, отдельный Rust-проект) ---
# Без обеих переменных ниже поддержка Deezer (ссылки + поиск) будет выключена,
# остальной функционал бота (TikTok) продолжит работать как раньше.

# Базовый URL задеплоенного dzmedia, БЕЗ слэша на конце.
# Например: https://dzmedia.fly.dev
DEEZER_API_URL=

# ARL-кука аккаунта Deezer — нужна dzmedia-серверу, чтобы получать и
# расшифровывать реальные аудио-ссылки. Достаётся из cookies браузера
# на deezer.com (кука "arl") после логина в аккаунт.
DEEZER_ARL=

# Необязательно: стартовое качество треков — FLAC / MP3_320 / MP3_128,
# по умолчанию MP3_320. Дальше переключается прямо в Telegram командой
# /quality, выбор сохраняется в Redis (если настроен) и переживает рестарт.
DEEZER_FORMAT=MP3_320

# Необязательно: сколько мс ждать ответа от dzmedia /send_audio для больших
# треков (сервер сам качает/тегирует/грузит в Telegram), по умолчанию 60000.
DEEZER_SEND_AUDIO_TIMEOUT_MS=60000
