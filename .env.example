# Токен бота от @BotFather
BOT_TOKEN=

# Твой числовой Telegram id (узнать можно у @userinfobot) — только этому
# id бот будет отвечать
OWNER_ID=

# Необязательно, но рекомендуется — иначе список каналов не переживёт
# рестарт контейнера. Берётся в консоли Upstash (Redis → REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Автоматическая маршрутизация по типу контента ---
# Если заданы — бот отправляет файл сразу, без вопроса "куда отправить?":
# видео (TikTok/присланный файл) — в VIDEO_CHANNEL_ID, музыка (Deezer) —
# в MUSIC_CHANNEL_ID. Chat id узнать так: добавь бота админом в канал или
# перешли ему любое сообщение из канала, потом посмотри /channels — там
# будет id вида -100xxxxxxxxxx.
# Если какой-то из id не задан — для этого типа контента бот вернётся к
# старому поведению и спросит канал кнопками.
VIDEO_CHANNEL_ID=
MUSIC_CHANNEL_ID=

# --- Deezer (dzmedia-сервер, отдельный Rust-проект) ---
# Без обеих переменных ниже поддержка Deezer (ссылки + поиск) будет выключена,
# остальной функционал бота (TikTok) продолжит работать как раньше.

# Базовый URL dzmedia. Начиная с этой версии dzmedia компилируется и
# запускается ВНУТРИ ЭТОГО ЖЕ контейнера (см. dzmedia-src/, entrypoint.sh) —
# отдельно его никуда деплоить не нужно, просто оставь как есть:
DEEZER_API_URL=http://127.0.0.1:8080

# ARL-кука аккаунта Deezer — нужна dzmedia-серверу, чтобы получать и
# расшифровывать реальные аудио-ссылки. Достаётся из cookies браузера
# на deezer.com (кука "arl") после логина в аккаунт.
DEEZER_ARL=

# Необязательно: стартовое качество треков — FLAC / MP3_320 / MP3_128,
# по умолчанию MP3_320. Дальше переключается прямо в Telegram командой
# /quality, выбор сохраняется в Redis (если настроен) и переживает рестарт.
DEEZER_FORMAT=MP3_320

# Необязательно: сколько мс ждать ответа от dzmedia /send_audio для больших
# треков (сервер сам качает/тегирует/грузит в Telegram), по умолчанию 60000.
DEEZER_SEND_AUDIO_TIMEOUT_MS=60000

# Необязательно: прокси (http://, https:// или socks5://, логин:пароль можно
# прямо в URL) для запросов dzmedia к Deezer. Нужен, если сервер задеплоен
# в стране, где какие-то треки не лицензированы — Deezer проверяет доступность
# трека по IP, с которого дёргают media.deezer.com/v1/get_url, а не по стране
# аккаунта, поэтому часть треков может молча не скачиваться (media: пустой
# список при 200 OK) именно из-за региона сервера, а не самого трека.
# Частый случай — хостинг именно в Германии: из-за GEMA там нередко блокируют
# отдельные треки, которых нет проблем стримить из других стран ЕС (France,
# Netherlands и т.п. — туда и стоит поднимать прокси). Без переменной прокси
# не используется, поведение как раньше.
DEEZER_PROXY=
